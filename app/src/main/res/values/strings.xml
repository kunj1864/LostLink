    <string name="about_title">About Lost &amp; Found</string>
    <string name="about_intro">Lost &amp; Found helps people report, search and manage lost and found items in one place. This Android edition stores its accounts and reports on this device.</string>
    <string name="about_features_title">Our features</string>
    <string name="about_features">Register and sign in\nReport lost and found items\nSearch by item, category and location\nManage your own reports\nSend claim requests and messages\nShare feedback with an administrator</string>
    <string name="about_why_title">Why use the system?</string>
    <string name="about_why">Save time with quick reporting and search. Keep reports organized, compare possible matches and coordinate item returns through local claim and message tools.</string>
