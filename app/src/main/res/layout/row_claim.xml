<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="11dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/claimItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/claimStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/blue"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/claimPerson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/claimDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/claimMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_icon_tile_blue"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/messageClaimButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="11dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/message_participant"
        android:textAllCaps="false"
        android:textColor="@color/blue"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/approveClaimButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/approve_claim"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <Button
            android:id="@+id/rejectClaimButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/reject_claim"
            android:textAllCaps="false"
            android:textColor="@color/error"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/resolveClaimButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_primary_button"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/mark_resolved"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
