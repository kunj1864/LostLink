<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/detailsBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/back"
            android:textColor="@color/blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/detailsPhoto"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/item_photo_label"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_lostlink" />

        <TextView
            android:id="@+id/detailsType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:background="@drawable/bg_icon_tile_blue"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/blue"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailsName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailsCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/detailsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/detailsDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/detailsLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailsReporter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/detailsContactPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detailsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/detailsReviewStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/blue"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/playVideoButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/play_attached_video"
            android:textAllCaps="false"
            android:textColor="@color/blue"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/claimItemButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/request_claim"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/contactOwnerButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/message_reporter"
            android:textAllCaps="false"
            android:textColor="@color/blue"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/emailOwnerButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/email_reporter"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/callReporterButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/call_reporter"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/smsReporterButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/sms_reporter"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/manageClaimsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/manage_claims"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/possibleMatchesButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/view_possible_matches"
            android:textAllCaps="false"
            android:textColor="@color/success"
            android:textSize="14sp" />

        <Button
            android:id="@+id/editReportButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/edit_report_title"
            android:textAllCaps="false"
            android:textColor="@color/blue"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/deleteReportButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/delete_report"
            android:textAllCaps="false"
            android:textColor="@color/error"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/openMapButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/view_location"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
