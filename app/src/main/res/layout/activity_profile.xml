<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

    <TextView
        android:id="@+id/profileBackButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:text="@string/back"
        android:textColor="@color/blue"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/profile_title"
        android:textColor="@color/text_primary"
        android:textSize="27sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp">

        <TextView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_icon_tile_blue"
            android:gravity="center"
            android:text="LL"
            android:textColor="@color/blue"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profileEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="17dp">

        <TextView
            android:id="@+id/profileReportCount"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_tile_teal"
            android:gravity="center"
            android:textColor="@color/success"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:text="@string/profile_reports_count"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/profile_edit_title"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/profileEditName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="@string/name_label"
        android:inputType="textPersonName|textCapWords"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/text_primary" />

    <EditText
        android:id="@+id/profileEditUsername"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="@string/username_label"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/text_primary" />

    <EditText
        android:id="@+id/profileEditMobile"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:hint="@string/profile_mobile_label"
        android:inputType="phone"
        android:maxLength="10"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/text_primary" />

    <EditText
        android:id="@+id/profileEditAddress"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:gravity="top|start"
        android:hint="@string/profile_address_label"
        android:inputType="textPostalAddress|textMultiLine"
        android:padding="14dp"
        android:textColor="@color/text_primary" />

    <Button
        android:id="@+id/profileSaveButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_home_button_green"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/save_profile"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/offline_password_note"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/profileChangePasswordButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/change_password"
        android:textAllCaps="false"
        android:textColor="@color/blue"
        android:textSize="14sp" />

    <Button
        android:id="@+id/profileReportsButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_primary_button"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/profile_view_reports"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/profileClaimsButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/claims_action"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <Button
        android:id="@+id/profileNotificationsButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/notifications_action"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <Button
        android:id="@+id/profileAboutButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/about_title"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/profileContactButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/contact_title"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/profileFeedbackButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/feedback_title"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/profileMessagesButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/system_messages_title"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/profileAdminConsoleButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_home_button_green"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/admin_console_title"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/profileAdminReviewButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/admin_review_action"
        android:textAllCaps="false"
        android:textColor="@color/blue"
        android:textSize="15sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/enableNotificationsButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/enable_notifications"
        android:textAllCaps="false"
        android:textColor="@color/blue"
        android:textSize="14sp" />

    <Button
        android:id="@+id/profileLogoutButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="@string/logout"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
